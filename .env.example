# ============================================================
# Your AIOS Workspace — Environment Configuration
# ============================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control — it contains your secrets.
# The .gitignore file already prevents this, but be careful.
#
# As you install more AIOS modules, each one will tell you which
# API keys to add here. This file grows with your workspace.
# ============================================================

# --- Add API keys below as you install modules ---
# Each module's INSTALL.md will tell you exactly what to add.
# Example format:
#   SERVICE_NAME_API_KEY=your-key-here

# --- Reporting email notification (monthly_run.py) ---
# Sends Tonya a "reports are staged for review" email on the 1st of each month.
# For Gmail / Google Workspace: create an App Password at
#   https://myaccount.google.com/apppasswords  (requires 2-Step Verification)
# then paste the 16-character password into SMTP_APP_PASSWORD below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_APP_PASSWORD=
REPORT_NOTIFY_TO=you@yourdomain.com
