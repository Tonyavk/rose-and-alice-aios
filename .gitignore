# ============================================================
# AIOS Workspace — .gitignore
# Files and folders that should NEVER be committed to Git.
# This protects your secrets, avoids bloat, and keeps your
# repository clean.
# ============================================================

# --- Credentials (CRITICAL — never commit these) ---
.env
credentials/
*.pem
*.key

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- Data (generated — reproducible from collection scripts) ---
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/*.log

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- IDE ---
.vscode/
.idea/

# --- Temp files ---
*.tmp
*.bak

# --- Runtime logs (launchd stdout/stderr — regenerated each run) ---
logs/

# --- Claude Code agent worktrees (temporary repo copies) ---
.claude/worktrees/

# --- Node (if applicable) ---
node_modules/

# --- Generated outputs (PDFs, reports — large binaries) ---
outputs/
